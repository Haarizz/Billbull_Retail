          { "base": "180.00", "share": "6.04", "taxable": "173.96", "tax": "34.79", "total": "208.75" }
        ],
        "taxableTotal": "2880.00", "taxTotal": "170.09", "lineTotal": "3050.09", "subTotal": "2980.00"
      }
    },
    {
      "name": "screenshot regression - INCLUSIVE, AED 100 is customer-facing",
