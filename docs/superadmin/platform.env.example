# /etc/billbull/platform.env — install -m 600 -o root. Generate every secret with:
#   openssl rand -base64 48
# Never commit the real file. Back the two keys up in the password manager, apart from DB backups.

PLATFORM_DB_URL=jdbc:postgresql://127.0.0.1:5432/billbull_platform
PLATFORM_DB_USERNAME=billbull_platform
PLATFORM_DB_PASSWORD=<openssl rand -base64 32>

# Signs platform sessions. Different from every tenant's jwt.secret and from PLATFORM_ENC_KEY.
PLATFORM_JWT_SECRET=<openssl rand -base64 48>
# Encrypts stored tenant agent secrets and MFA seeds. Losing it means re-issuing every agent
# secret and re-enrolling every user's MFA.
PLATFORM_ENC_KEY=<openssl rand -base64 48>

# Token the servers' backup script sends with each report (X-Backup-Token).
PLATFORM_BACKUP_TOKEN=<openssl rand -base64 48>

# Public IPs this server uses to call the tenants; written into each tenant's nginx
# "location /api/platform/" allow-list by the provisioning kit.
PLATFORM_EGRESS_IPS=62.72.59.119

# First start only: creates the first OWNER, who must change this password and enrol MFA.
# Remove both lines after the first successful sign-in.
PLATFORM_BOOTSTRAP_EMAIL=owner@billbull.app
PLATFORM_BOOTSTRAP_PASSWORD=<a temporary password, 12+ characters>
